POSTGRES_DB=car_portal
POSTGRES_USER=car_portal
POSTGRES_PASSWORD=car_portal
DATABASE_URL=postgresql://car_portal:car_portal@postgres:5432/car_cms

FRONTEND_PORT=3000
BACKEND_PORT=4000
PGADMIN_PORT=5050

APP_BASE_URL=https://carmain.localhost.com
# Cabinet sidebar «Відкрити сайт» (defaults to APP_BASE_URL in docker-compose)
NEXT_PUBLIC_WEBSITE_URL=
API_BASE_URL=https://api.carmain.localhost.com
CMS_BASE_URL=https://cms.carmain.localhost.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
PGADMIN_DEFAULT_EMAIL=admin@carmain.localhost.com
PGADMIN_DEFAULT_PASSWORD=admin123

JWT_SECRET=replace-with-a-long-random-secret
COOKIE_DOMAIN=
COOKIE_SECURE=true
GOOGLE_CLIENT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notify@carmain.local

# Cloudflare R2 (optional). If all five are set, avatars & vehicle photos upload to R2.
# Otherwise files stay on backend disk (UPLOADS_DIR / Docker volume).
# 1) R2 → Create bucket → Settings → Public access (r2.dev subdomain) OR custom domain
# 2) R2 → Manage API tokens → Object Read & Write for this bucket
# R2_ACCOUNT_ID= (Cloudflare dashboard → R2 → right sidebar)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=carmain-uploads
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev  (no trailing slash)

# CMS → backend uploads (service station photos). Same value in backend and cms containers.
CMS_UPLOAD_SECRET=change-me-to-a-long-random-string
PORTAL_API_INTERNAL_URL=http://backend:4000

RABBITMQ_USER=car_portal
RABBITMQ_PASSWORD=car_portal
CMS_APP_SECRET=carmain-cms-dev-secret
CMS_ADMIN_EMAIL=editor@carmain.localhost.com
CMS_ADMIN_PASSWORD=carmain-admin-dev
CMS_UID=1000
CMS_GID=1000
REDIS_URL=redis://redis:6379
