COMPOSE_PROJECT_NAME=car-portal
PROD_HTTP_PORT=8081

POSTGRES_DB=car_portal
POSTGRES_USER=car_portal
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://car_portal:change-me@postgres:5432/car_cms

APP_BASE_URL=https://car.ics-vortex.com
API_BASE_URL=https://api.car.ics-vortex.com
CMS_BASE_URL=https://cms.car.ics-vortex.com
COOKIE_DOMAIN=.ics-vortex.com
COOKIE_SECURE=true

JWT_SECRET=change-me
CMS_APP_SECRET=change-me
CMS_UPLOAD_SECRET=change-me
RABBITMQ_USER=car_portal
RABBITMQ_PASSWORD=change-me
CMS_ADMIN_PASSWORD=change-me

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Mail/CMS identities: use real addresses on the server .env only (example.com avoids secret scanners).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notify@example.com
CMS_ADMIN_EMAIL=editor@example.com

REDIS_URL=redis://redis:6379
